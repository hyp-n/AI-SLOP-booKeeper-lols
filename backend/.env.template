# MongoDB Atlas connection string
# Get this from: mongodb.com → Database → Connect → Drivers → Python
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bookeeper?retryWrites=true&w=majority

# Database name
MONGODB_DB_NAME=bookeeper

# Flask secret key (auto-generated if not set)
# SECRET_KEY=your-secret-key-here

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flask debug mode
FLASK_DEBUG=false
